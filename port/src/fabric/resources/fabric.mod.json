      ],
      "net/minecraft/client/renderer/block/dispatch/BlockStateModelPart": [
        "mekanism/neoshim/neoforge/client/extensions/BlockStateModelPartExtension"
      ],
      "net/minecraft/client/resources/model/geometry/UnbakedGeometry": [
        "mekanism/neoshim/neoforge/client/extensions/UnbakedGeometryExtension"
