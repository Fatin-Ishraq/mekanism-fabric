      ],
      "net/minecraft/world/entity/LightningBolt": [
        "mekanism/neoshim/neoforge/common/extensions/ILightningBoltExtension"
      ],
      "net/minecraft/network/protocol/configuration/ServerConfigurationPacketListener": [
        "mekanism/neoshim/neoforge/common/extensions/IServerConfigurationPacketListenerExtension"
      ],
      "net/minecraft/world/item/CreativeModeTab": [
        "mekanism/neoshim/neoforge/common/extensions/ICreativeModeTabExtension"
      ],
      "net/minecraft/world/entity/EntityType$Builder": [
        "mekanism/neoshim/neoforge/common/extensions/IEntityTypeBuilderExtension<TT;>"
      ],
      "net/minecraft/world/item/CreativeModeTab$Builder": [
        "mekanism/neoshim/neoforge/common/extensions/ICreativeModeTabBuilderExtension"
      ],
      "net/minecraft/world/item/DispensibleContainerItem": [
        "mekanism/neoshim/neoforge/common/extensions/IDispensibleContainerItemExtension"
      ],
      "net/minecraft/client/KeyMapping": [
        "mekanism/neoshim/neoforge/client/extensions/IKeyMappingExtension"
      ],
      "net/minecraft/client/gui/components/AbstractWidget": [
        "mekanism/neoshim/neoforge/client/extensions/IAbstractWidgetExtension"
      ],
      "net/minecraft/client/gui/screens/Screen": [
        "mekanism/neoshim/neoforge/client/extensions/IScreenExtension"
      ],
      "net/minecraft/client/gui/screens/inventory/AbstractContainerScreen": [
        "mekanism/neoshim/neoforge/client/extensions/IAbstractContainerScreenExtension"
      ],
      "com/mojang/blaze3d/vertex/VertexConsumer": [
        "mekanism/neoshim/neoforge/client/extensions/IVertexConsumerExtension"
      ],
      "net/minecraft/client/resources/model/ModelManager": [
        "mekanism/neoshim/neoforge/client/extensions/IModelManagerExtension"
      ],
      "net/minecraft/client/renderer/entity/EntityRenderDispatcher": [
