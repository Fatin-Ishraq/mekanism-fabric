      "net/minecraft/world/level/BlockGetter": [
        "mekanism/neoshim/neoforge/common/extensions/IBlockGetterExtension"
      ],
      "net/minecraft/world/entity/Entity": [
        "mekanism/neoshim/neoforge/common/extensions/IEntityExtension",
        "mekanism/neoshim/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/world/entity/LivingEntity": [
        "mekanism/neoshim/neoforge/common/extensions/ILivingEntityExtension"
      ],
      "net/minecraft/world/entity/player/Player": [
        "mekanism/neoshim/neoforge/common/extensions/IPlayerExtension"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity": [
        "mekanism/neoshim/neoforge/common/extensions/IBlockEntityExtension",
        "mekanism/neoshim/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/world/level/chunk/ChunkAccess": [
        "mekanism/neoshim/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/core/Holder": [
        "mekanism/neoshim/neoforge/common/extensions/IHolderExtension<TT;>"
      ],
      "net/minecraft/core/Registry": [
        "mekanism/neoshim/neoforge/common/extensions/IRegistryExtension<TT;>"
      ],
      "net/minecraft/world/item/crafting/Ingredient": [
        "mekanism/neoshim/neoforge/common/extensions/IIngredientExtension"
      ],
      "net/minecraft/world/effect/MobEffectInstance": [
        "mekanism/neoshim/neoforge/common/extensions/IMobEffectInstanceExtension"
      ],
      "net/minecraft/world/entity/EntityType": [
        "mekanism/neoshim/neoforge/common/extensions/IEntityTypeExtension"
      ],
      "net/minecraft/world/level/biome/Biome": [
        "mekanism/neoshim/neoforge/common/extensions/IBiomeExtension"
      ],
      "com/mojang/math/Transformation": [
        "mekanism/neoshim/neoforge/common/extensions/ITransformationExtension"
      ],
      "net/minecraft/world/MenuProvider": [
        "mekanism/neoshim/neoforge/common/extensions/IMenuProviderExtension"
      ],
      "net/minecraft/world/inventory/Slot": [
        "mekanism/neoshim/neoforge/common/extensions/ISlotExtension"
