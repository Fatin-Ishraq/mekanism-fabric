{
  "schemaVersion": 1,
  "id": "mekanism_fabric",
  "version": "${version}",
  "name": "Mekanism Fabricated",
  "description": "Fabric port of Mekanism, a Minecraft add-on featuring high-tech machinery that can be used to create powerful tools, armor, and weapons. Unofficial: not affiliated with or endorsed by the Mekanism team. Please report bugs to this port, not to the official Mekanism issue tracker.",
  "authors": [
    "Aidancbrady (original Mekanism)",
    "Thommy101 (original Mekanism)",
    "Thiakil (original Mekanism)",
    "pupnewfster (original Mekanism)",
    "dizzyd (original Mekanism)"
  ],
  "contributors": [
    "Fatin-Ishraq (Fabric port)"
  ],
  "contact": {
    "homepage": "https://github.com/Fatin-Ishraq/mekanism-fabric",
    "sources": "https://github.com/Fatin-Ishraq/mekanism-fabric",
    "issues": "https://github.com/Fatin-Ishraq/mekanism-fabric/issues"
  },
  "license": "MIT",
  "icon": "assets/mekanism_fabric/icon.png",
  "environment": "*",
  "provides": [
    "mekanism"
  ],
  "entrypoints": {
    "main": [
      "mekanism.fabric.MekanismFabric"
    ],
    "client": [
      "mekanism.fabric.client.MekanismFabricClient"
    ],
    "jei_mod_plugin": [
      "mekanism.client.recipe_viewer.jei.MekanismJEI"
    ],
    "emi": [
      "mekanism.client.recipe_viewer.emi.MekanismEmi"
    ],
    "jade": [
      "mekanism.common.integration.lookingat.jade.MekanismJadePlugin"
    ]
  },
  "mixins": [
    "mekanism_fabric.mixins.json"
  ],
  "accessWidener": "mekanism.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": ">=${fcap_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.wiki": "https://wiki.aidancbrady.com/wiki/Mekanism"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/world/item/Item": [
        "mekanism/neoshim/neoforge/common/extensions/IItemExtension"
      ],
      "net/minecraft/world/item/ItemStack": [
        "mekanism/neoshim/neoforge/common/extensions/IItemStackExtension",
        "mekanism/neoshim/neoforge/common/extensions/IMutableDataComponentHolderExtension"
      ],
      "net/minecraft/world/item/ItemInstance": [
        "mekanism/neoshim/neoforge/common/extensions/ItemInstanceExtension"
      ],
      "net/minecraft/core/component/DataComponentHolder": [
        "mekanism/neoshim/neoforge/common/extensions/IDataComponentHolderExtension"
      ],
      "net/minecraft/core/component/DataComponentMap$Builder": [
        "mekanism/neoshim/neoforge/common/extensions/IDataComponentMapBuilderExtension"
      ],
      "net/minecraft/core/component/DataComponentPatch$Builder": [
        "mekanism/neoshim/neoforge/common/extensions/IDataComponentPatchBuilderExtension"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity$DataComponentInput": [
        "mekanism/neoshim/neoforge/common/extensions/IBlockEntityDataComponentInputExtension"
      ],
      "net/minecraft/world/item/Item$Properties": [
        "mekanism/neoshim/neoforge/common/extensions/IItemPropertiesExtension"
      ],
      "net/minecraft/world/level/block/Block": [
        "mekanism/neoshim/neoforge/common/extensions/IBlockExtension"
      ],
      "net/minecraft/world/level/block/state/BlockBehaviour$BlockStateBase": [
        "mekanism/neoshim/neoforge/common/extensions/IBlockStateExtension"
      ],
      "net/minecraft/world/level/material/Fluid": [
        "mekanism/neoshim/neoforge/common/extensions/IFluidExtension"
      ],
      "net/minecraft/world/level/material/FluidState": [
        "mekanism/neoshim/neoforge/common/extensions/IFluidStateExtension"
      ],
      "net/minecraft/world/level/Level": [
        "mekanism/neoshim/neoforge/common/extensions/ILevelExtension",
        "mekanism/neoshim/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/core/HolderLookup$Provider": [
        "mekanism/neoshim/neoforge/common/extensions/IHolderLookupProviderExtension"
