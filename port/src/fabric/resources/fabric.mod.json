      ],
      "net/minecraft/client/particle/Particle": [
        "mekanism/neoshim/neoforge/client/extensions/IParticleExtension"
      ],
      "net/minecraft/client/particle/TerrainParticle": [
        "mekanism/neoshim/neoforge/client/extensions/ITerrainParticleExtension"
      ],
      "net/minecraft/client/particle/ParticleEngine": [
        "mekanism/neoshim/neoforge/client/extensions/IParticleEngineExtension"
